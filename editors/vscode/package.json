{
  "name": "veyl-lang",
  "displayName": "Veyl",
  "description": "Highlighting, errors as you type, completion and go to definition for the Veyl programming language",
  "version": "0.65.0",
  "publisher": "veyl",
  "license": "MIT",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:veyl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "veyl",
        "aliases": [
          "Veyl",
          "veyl"
        ],
        "extensions": [
          ".vl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/veyl.png",
          "dark": "./icons/veyl.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "veyl",
        "scopeName": "source.veyl",
        "path": "./syntaxes/veyl.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[veyl]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    },
    "configuration": {
      "title": "Veyl",
      "properties": {
        "veyl.path": {
          "type": "string",
          "default": "",
          "description": "The veyl executable that runs the language server. Empty means veyl on PATH."
        }
      }
    }
  },
  "icon": "icons/veyl.png"
}
