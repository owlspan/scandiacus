{
  "name": "scandiacus-lang",
  "displayName": "Scandiacus",
  "description": "Highlighting, errors as you type, completion, go to definition, and a button to run or build the file, for the Scandiacus programming language",
  "version": "1.101.0",
  "publisher": "scandiacus",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:scandiacus",
    "onCommand:scandiacus.run",
    "onCommand:scandiacus.build"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scandiacus",
        "aliases": [
          "Scandiacus",
          "scandiacus"
        ],
        "extensions": [
          ".scd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/scandiacus-file.png",
          "dark": "./icons/scandiacus-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "scandiacus",
        "scopeName": "source.scandiacus",
        "path": "./syntaxes/scandiacus.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[scandiacus]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    },
    "configuration": {
      "title": "Scandiacus",
      "properties": {
        "scandiacus.path": {
          "type": "string",
          "default": "",
          "description": "The scandiacus executable used for the language server and the run and build buttons. Empty means scandiacus on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "scandiacus.run",
        "title": "Run Scandiacus File",
        "category": "Scandiacus",
        "icon": "$(play)"
      },
      {
        "command": "scandiacus.build",
        "title": "Build Scandiacus Executable",
        "category": "Scandiacus",
        "icon": "$(package)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "scandiacus.run",
          "when": "resourceLangId == scandiacus",
          "group": "navigation@0"
        },
        {
          "command": "scandiacus.build",
          "when": "resourceLangId == scandiacus",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "scandiacus.run",
          "when": "resourceLangId == scandiacus",
          "group": "scandiacus@0"
        },
        {
          "command": "scandiacus.build",
          "when": "resourceLangId == scandiacus",
          "group": "scandiacus@1"
        }
      ],
      "explorer/context": [
        {
          "command": "scandiacus.run",
          "when": "resourceLangId == scandiacus",
          "group": "scandiacus@0"
        },
        {
          "command": "scandiacus.build",
          "when": "resourceLangId == scandiacus",
          "group": "scandiacus@1"
        }
      ],
      "commandPalette": [
        {
          "command": "scandiacus.run",
          "when": "editorLangId == scandiacus"
        },
        {
          "command": "scandiacus.build",
          "when": "editorLangId == scandiacus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scandiacus.run",
        "key": "ctrl+f5",
        "when": "editorLangId == scandiacus"
      }
    ]
  },
  "icon": "icons/scandiacus.png"
}
