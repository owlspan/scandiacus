%YAML 1.2
---
# Generated by 'veyl editors'. Do not edit: re-run it instead.
name: Veyl
file_extensions: [vl]
scope: source.veyl

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: Keywords
    - include: types
    - include: builtins

  comments:
    - match: //
      scope: punctuation.definition.comment.veyl
      push:
        - meta_scope: comment.line.double-slash.veyl
        - match: $\n?
          pop: true
    # Block comments nest, so the same rule pushes itself.
    - match: /\*
      scope: punctuation.definition.comment.veyl
      push:
        - meta_scope: comment.block.veyl
        - match: /\*
          push:
            - meta_scope: comment.block.veyl
            - match: \*/
              pop: true
        - match: \*/
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.veyl
      push:
        - meta_scope: string.quoted.double.veyl
        - match: '\\(x\h\h|u\{\h{1,6}\}|.)'
          scope: constant.character.escape.veyl
        # Interpolation: any expression between braces.
        - match: '\{'
          scope: punctuation.section.interpolation.begin.veyl
          push:
            - meta_scope: meta.interpolation.veyl
            - clear_scopes: 1
            - match: '\}'
              scope: punctuation.section.interpolation.end.veyl
              pop: true
            - include: main
        - match: '"'
          scope: punctuation.definition.string.end.veyl
          pop: true
    - match: '`'
      scope: punctuation.definition.string.begin.veyl
      push:
        - meta_scope: string.quoted.other.raw.veyl
        - match: '`'
          scope: punctuation.definition.string.end.veyl
          pop: true

  numbers:
    - match: '\b0[xX][0-9a-fA-F_]+\b'
      scope: constant.numeric.hex.veyl
    - match: '\b0[bB][01_]+\b'
      scope: constant.numeric.binary.veyl
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?\b'
      scope: constant.numeric.veyl

  Keywords:
    - match: '\b(break|const|continue|defer|else|enum|export|extern|false|fn|for|if|impl|import|in|let|match|new|nil|own|pub|return|self|step|struct|true|unsafe|var|while)\b'
      scope: keyword.control.veyl

  types:
    - match: '\b(int|float|str|bool|bytes|void|i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|ptr)\b'
      scope: storage.type.veyl

  builtins:
    - match: '\b(args|bits|bytes|csv|hash|http|json|log|mem|net|os|rand|re|sound|stats|task|term|time|url|win|zip)\b'
      scope: support.function.veyl
    - match: '\b(E|INF|NAN|PI|abs|acos|all|any|asin|atan|atan2|beep|cbrt|ceil|charAt|chars|clamp|clear|contains|cos|count|divf|each|endsWith|errorOf|exit|exp|fail|failed|filter|find|first|float|floor|has|hideConsole|hypot|indexOf|input|insert|int|isFloat|isInt|isNan|isOk|isWin11|join|keys|last|len|lines|log|log10|log2|lower|map|max|messageBox|min|mod|must|ok|openWindow|padLeft|padRight|pause|pop|pow|print|push|random|randomInt|reduce|remove|removeAt|repeat|replace|reverse|round|setTitle|sign|sin|sleep|slice|sort|sortBy|split|sqrt|startsWith|str|substr|sum|tan|toFloat|toInt|trim|trunc|upper|valueOr|values|winBuild|write)\b'
      scope: support.function.veyl
