// A voice changer: the microphone, through an effect, to the speakers.
//
//   veyl run robot.vl            a robot voice for ten seconds
//   veyl run robot.vl -- echo    an echo instead
//
// To hear it in Discord or a game, send the output to a virtual audio
// cable (VB-Audio Cable is free) and pick the cable as the microphone
// there; set the cable as the default playback device first, since
// audio.output plays on the default one.

let rate = 48000
let frames = 480            // 10 ms blocks: a small delay, a smooth sound

let mic = must(audio.input(rate, 1, frames))
let out = must(audio.output(rate, 1, frames))

let mode = "robot"
if contains(args.rest(), "echo") {
    mode = "echo"
}

// The robot is ring modulation: the voice times a 60 Hz sine.
let phase = 0.0
let turn = 2.0 * PI * 60.0 / float(rate)

// The echo is a quarter of a second ago, at half the volume.
let delay: []float = []
for i in 0..rate / 4 {
    push(delay, 0.0)
}
let at = 0

print("{mode} on for ten seconds - speak")
let blocks = 10 * rate / frames
for b in 0..blocks {
    let block = audio.read(mic)
    let changed: []float = []
    for v in block {
        if mode == "robot" {
            push(changed, v * sin(phase) * 2.0)
            phase += turn
        } else {
            let past = delay[at]
            delay[at] = v + past * 0.5
            push(changed, v + past * 0.5)
            at = (at + 1) % len(delay)
        }
    }
    audio.write(out, changed)
}
audio.close(mic)
audio.close(out)
