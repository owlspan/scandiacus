// url.join resolves a reference as Go's URL.ResolveReference does:
// the examples of RFC 3986 section 5.4 against its base.
print("g:h -> " + must(url.join("http://a/b/c/d;p?q", "g:h")))
print("g -> " + must(url.join("http://a/b/c/d;p?q", "g")))
print("./g -> " + must(url.join("http://a/b/c/d;p?q", "./g")))
print("g/ -> " + must(url.join("http://a/b/c/d;p?q", "g/")))
print("/g -> " + must(url.join("http://a/b/c/d;p?q", "/g")))
print("//g -> " + must(url.join("http://a/b/c/d;p?q", "//g")))
print("?y -> " + must(url.join("http://a/b/c/d;p?q", "?y")))
print("g?y -> " + must(url.join("http://a/b/c/d;p?q", "g?y")))
print("#s -> " + must(url.join("http://a/b/c/d;p?q", "#s")))
print("g#s -> " + must(url.join("http://a/b/c/d;p?q", "g#s")))
print("g?y#s -> " + must(url.join("http://a/b/c/d;p?q", "g?y#s")))
print(";x -> " + must(url.join("http://a/b/c/d;p?q", ";x")))
print("g;x -> " + must(url.join("http://a/b/c/d;p?q", "g;x")))
print("g;x?y#s -> " + must(url.join("http://a/b/c/d;p?q", "g;x?y#s")))
print(" -> " + must(url.join("http://a/b/c/d;p?q", "")))
print(". -> " + must(url.join("http://a/b/c/d;p?q", ".")))
print("./ -> " + must(url.join("http://a/b/c/d;p?q", "./")))
print(".. -> " + must(url.join("http://a/b/c/d;p?q", "..")))
print("../ -> " + must(url.join("http://a/b/c/d;p?q", "../")))
print("../g -> " + must(url.join("http://a/b/c/d;p?q", "../g")))
print("../.. -> " + must(url.join("http://a/b/c/d;p?q", "../..")))
print("../../ -> " + must(url.join("http://a/b/c/d;p?q", "../../")))
print("../../g -> " + must(url.join("http://a/b/c/d;p?q", "../../g")))
print("../../../g -> " + must(url.join("http://a/b/c/d;p?q", "../../../g")))
print("../../../../g -> " + must(url.join("http://a/b/c/d;p?q", "../../../../g")))
print("/./g -> " + must(url.join("http://a/b/c/d;p?q", "/./g")))
print("/../g -> " + must(url.join("http://a/b/c/d;p?q", "/../g")))
print("g. -> " + must(url.join("http://a/b/c/d;p?q", "g.")))
print(".g -> " + must(url.join("http://a/b/c/d;p?q", ".g")))
print("g.. -> " + must(url.join("http://a/b/c/d;p?q", "g..")))
print("..g -> " + must(url.join("http://a/b/c/d;p?q", "..g")))
print("./../g -> " + must(url.join("http://a/b/c/d;p?q", "./../g")))
print("./g/. -> " + must(url.join("http://a/b/c/d;p?q", "./g/.")))
print("g/./h -> " + must(url.join("http://a/b/c/d;p?q", "g/./h")))
print("g/../h -> " + must(url.join("http://a/b/c/d;p?q", "g/../h")))
print("g;x=1/./y -> " + must(url.join("http://a/b/c/d;p?q", "g;x=1/./y")))
print("g;x=1/../y -> " + must(url.join("http://a/b/c/d;p?q", "g;x=1/../y")))
print("g?y/./x -> " + must(url.join("http://a/b/c/d;p?q", "g?y/./x")))
print("g?y/../x -> " + must(url.join("http://a/b/c/d;p?q", "g?y/../x")))
print("g#s/./x -> " + must(url.join("http://a/b/c/d;p?q", "g#s/./x")))
print("g#s/../x -> " + must(url.join("http://a/b/c/d;p?q", "g#s/../x")))
print("a b/c -> " + must(url.join("http://a/b/c/d;p?q", "a b/c")))
