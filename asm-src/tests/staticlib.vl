extern fn vy_add(a: int, b: int) -> int from "staticlib.a"
extern fn vy_sumsq(x: int) -> int from "staticlib.a"
extern fn vy_prime(i: int) -> int from "staticlib.a"
extern fn vy_bump() -> int from "staticlib.a"

print("{vy_add(3, 4)}")
print("{vy_sumsq(2)}")
print("{vy_prime(0)} {vy_prime(4)}")
print("{vy_bump()}")
print("{vy_bump()}")
