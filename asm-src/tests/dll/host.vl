// Loads mathmod.dll, built from mathmod.vl with `veyl build --dll`, and
// calls what it exports. TestDLL builds the library first.

extern fn LoadLibraryA(name: str) -> ptr
extern fn GetProcAddress(lib: ptr, name: str) -> ptr

// An exported int is a 64-bit value, so it is declared ptr here, which
// is how an extern says "all 64 bits".
extern fn add(a: ptr, b: ptr) -> ptr from "mathmod"
extern fn hypotenuse(a: float, b: float) -> float from "mathmod"
extern fn shout(s: str) -> ptr from "mathmod"
extern fn either(a: bool, b: bool) -> bool from "mathmod"
extern struct Pair { x: i32, y: i32 }
extern fn swap(p: Pair) from "mathmod"
extern fn narrow(a: u8, b: i8, c: u16, d: i16) from "mathmod"
extern fn blend(a: f32, b: f32, t: f32) -> f32 from "mathmod"

print("host running")
print(add(40, 2))
print(add(-5000000000, 1))
print(hypotenuse(3, 4))
print(shout("quiet"))
print(either(false, true))
print(either(false, false))
let p = Pair{x: 1, y: 2}
swap(p)
print(p)

// A second copy under another name cannot share the first one's
// address, so it is moved - and has to run just the same.
let first = LoadLibraryA("mathmod.dll")
let second = LoadLibraryA("mathmod2.dll")
print(first != 0 && second != 0 && first != second)
print(GetProcAddress(first, "add") != 0)
print(GetProcAddress(first, "missing") == 0)

// Fixed-width arguments, through a declaration and then as raw words
// with junk above each value's width.
narrow(200, -100, 60000, -30000)
let dirty = 0x7777777700000000
mem.call(GetProcAddress(first, "narrow"), dirty | 200, dirty | 0x9C, dirty | 60000, dirty | 0x8AD0)
mem.call(GetProcAddress(first, "narrow6"), 1, 2, 3, 4, dirty | 4000000000, dirty | 0xFF)
print(blend(0, 10, 0.3))
print(blend(0.1, 0.7, 0.5))
