// A float prints as the shortest decimal that reads back to the same
// value, with a tie between two such decimals going to the even one.
// Each of these printed a wrong last digit, or another number entirely,
// when the digits came from msvcrt.
print(662.2272727272727)
print(9.275643977104921e-06)
print(4.2118625339184216e+16)
print(3.3493625997681517e+17)
// Exact ties: the value is halfway between two 16-digit decimals.
print(756459817367716.25)
print(756459817367716.75)
print(1516928001910415.25)
print(-1172442968800055.25)
// Ordinary ones, and the switch to exponent form.
print(0.1)
print(0.1 + 0.2)
print(1.0 / 3.0)
print(123456.0)
print(1234567.0)
print(1e-05)
print(5e-324)
print(1.7976931348623157e+308)
let x: f32 = 0.1
print(x)
print(f32(1.0) / f32(3.0))
